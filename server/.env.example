# Copy to server/.env and fill in. Everything here has a working default for
# local development except DATABASE_URL, which falls back to SQLite when unset.

# ---------------------------------------------------------------- Django

DJANGO_SECRET_KEY=change-me-to-something-random
DJANGO_DEBUG=true
# Only used when DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.serving.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.serving.app

# ---------------------------------------------------------------- database

# Neon. `neon deploy` (or `neon env pull`) run from server/ fills these in
# from the project linked in server/.neon:
#
#   DATABASE_URL           pooled (-pooler host) — what the app uses
#   DATABASE_URL_UNPOOLED  direct — used automatically by migrate/test/dbshell
#
# DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxx-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://neondb_owner:PASSWORD@ep-xxx.us-west-2.aws.neon.tech/neondb?sslmode=require
#
# Leave both unset to use a local SQLite file (server/db.sqlite3).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

DB_SSL_REQUIRE=true
DB_CONN_MAX_AGE=600

# ---------------------------------------------------------------- auth

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30

# Must match PRODUCT_BUNDLE_IDENTIFIER in the Xcode project — it's the
# audience claim in Apple's identity token.
APPLE_BUNDLE_ID=app.serving.Serving

# iOS client id(s) from Google Cloud Console, comma separated.
GOOGLE_CLIENT_IDS=

# Skips signature verification on OAuth identity tokens so the simulator can
# sign in before the client SDKs are wired up. Defaults to DJANGO_DEBUG.
# NEVER enable this in production.
OAUTH_ALLOW_UNVERIFIED_TOKENS=true

# ---------------------------------------------------------------- SMS

# Without these, verification codes are printed to the server console and
# (in DEBUG) returned as `dev_code` in the response.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PHONE_CODE_TTL_MINUTES=10
PHONE_CODE_MAX_ATTEMPTS=5

# ---------------------------------------------------------------- payments

# Without a secret key, captures are simulated so the order flow still works.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Serving's cut. Mirrored by PricingEngine.swift — change both together.
PLATFORM_FEE_RATE=0.06
PLATFORM_FEE_MINIMUM=1.49
DEFAULT_TAX_RATE=0.0913

# ---------------------------------------------------------------- push

# Apple Developer → Keys → APNs auth key (.p8)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=
APNS_TOPIC=app.serving.Serving
APNS_USE_SANDBOX=true
